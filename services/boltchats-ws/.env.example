# App
APP_NAME=boltchats-ws
APP_VERSION=1.0.0
ENVIRONMENT=development

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — must match boltchats-api SECRET_KEY
SECRET_KEY=change-me-to-a-strong-random-secret
ALGORITHM=HS256

# Rate limiting
RATE_LIMIT_CONNECTIONS_PER_USER=5
RATE_LIMIT_MESSAGES_PER_SECOND=10
