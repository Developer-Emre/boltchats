# App
APP_NAME=boltchats-api
APP_VERSION=1.0.0
ENVIRONMENT=development

# MongoDB
MONGODB_URL=mongodb://root:rootpassword@localhost:27017/boltchats?authSource=admin
MONGODB_DB_NAME=boltchats

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — change this to a strong random secret in production
SECRET_KEY=change-me-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
